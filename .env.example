APP_ENV=development
DATABASE_PATH=./agentway_leads.db
BASE_URL=https://agentway.ai
TRACKING_BASE_URL=http://localhost:8080
HOST=0.0.0.0
PORT=8080
EMAIL_PROVIDER=gmail
# Draft creation is independent from the legacy/future sending provider.
DRAFT_PROVIDER=gmail
EMAIL_FROM_NAME=Sabeen
# Phase one mailbox: OAuth should request gmail.insert only.
EMAIL_FROM_EMAIL=sabeen@agentway-ai.com
GMAIL_ACCESS_TOKEN=
GMAIL_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REPLY_TO_EMAIL=sabeen@agentway-ai.com
GMAIL_USER_ID=me
HUBSPOT_BCC_EMAIL=
SLACK_WEBHOOK_URL=
ADMIN_TOKEN=
# Creates due Gmail drafts when HubSpot webhooks or scheduled syncs run.
AUTOMATIC_DRAFT_ENABLED=false
# Reserved for the later sending phase. It is not used by draft-only code.
AUTOMATIC_EMAIL_ENABLED=false

# HubSpot
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Google Sheets
GOOGLE_SHEET_ID=
SHEETS_APPS_SCRIPT_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Granola
GRANOLA_API_KEY=
GRANOLA_API_BASE=https://api.granola.ai

# HubSpot webhooks
HUBSPOT_WEBHOOK_SECRET=
